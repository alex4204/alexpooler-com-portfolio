# Copy to .env.local and fill in. Everything here is read on the server only.
# In production (compose.prod.yaml) this is .env on the server instead, and
# REDIS_URL is set by the compose file.

# Ask AI: which model answers, as "provider:model". Required: there is no
# default. For example anthropic:claude-haiku-5-5.
ASK_MODEL=

# The key for that provider, also required. Only the one in use is needed.
ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=

# Redis holds Ask AI's rate limits, and is required: without it Ask AI is off.
# `docker compose up -d redis` starts one locally.
REDIS_URL=redis://localhost:6379

# Ask AI limits. The values shown are the defaults.
ASK_MAX_MESSAGES=10
ASK_MAX_QUESTION_LENGTH=500
# Questions per visitor in a sliding window.
ASK_RATE_LIMIT=12
ASK_RATE_WINDOW_MINUTES=10
# Tokens a day for the whole site, counted from what each answer really used.
ASK_DAILY_TOKEN_BUDGET=2000000

# Production only: the Cloudflare Tunnel's token, for compose.prod.yaml.
# TUNNEL_TOKEN=
